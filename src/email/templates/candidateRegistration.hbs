<!doctype html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style type="text/css">
        body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
        }

        table {
            border-collapse: collapse;
        }

        img {
            border: 0;
            outline: none;
            text-decoration: none;
            -ms-interpolation-mode: bicubic;
        }

        a {
            text-decoration: none;
        }

        .no-link a {
            color: inherit !important;
            text-decoration: none !important;
        }

        @media only screen and (max-width: 620px) {
            .shell {
                width: 100% !important;
            }

            .pad-lr {
                padding-left: 22px !important;
                padding-right: 22px !important;
            }

            .h1 {
                font-size: 21px !important;
            }

            .greeting {
                font-size: 19px !important;
            }

            .btn-cell a {
                display: block !important;
                width: auto !important;
            }

            .logo {
                width: 150px !important;
                height: auto !important;
            }
        }
    </style>
</head>

<body
    style="font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif !important; margin: 0; padding: 0;">

    <div
        style="display:none; font-size:1px; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all;">
        Congratulations! You passed your interview at {{companyName}}. Register now to continue.
        &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color:#f3f7fc;">
        <tr>
            <td align="center" style="padding:32px 12px;">

                <table role="presentation" class="shell" width="600" cellpadding="0" cellspacing="0" border="0"
                    style="width:600px; max-width:600px;">

                    <tr>
                        <td class="pad-lr" align="left" bgcolor="#f5faff"
                            style="padding:30px 40px 26px; background-color:#f5faff; border:1px solid #dce8f7; border-bottom:0; border-radius:16px 16px 0 0;">

                            <img class="logo" src="https://baystateinterpreters.com/assets/img/baystate_logo.png"
                                width="175" alt="{{companyName}}"
                                style="display:block; width:175px; max-width:175px; height:auto; border:0;" />

                            <p
                                style="margin:24px 0 7px; color:#4289c8; font-size:14px; font-weight:bold; line-height:16px; text-transform:uppercase; letter-spacing:1px;">
                                Interview outcome
                            </p>

                            <h1 class="h1"
                                style="margin:0; color:#35353a; font-size:24px; font-weight:bold; line-height:30px;">
                                Congratulations, you passed the interview!
                            </h1>

                            <p style="margin:8px 0 0; color:#64748b; font-size:14px; line-height:20px;">
                                You have successfully cleared your interview{{#if jobTitle}} for the {{jobTitle}}{{#if jobLocation}} ({{jobLocation}}){{/if}} role{{/if}}.
                                One last step remains: register your account to get started.
                            </p>

                        </td>
                    </tr>

                    <tr>
                        <td class="pad-lr" align="left" bgcolor="#ffffff"
                            style="padding:34px 40px 36px; background-color:#ffffff; border:1px solid #e0e8f2; border-top:0; border-radius:0 0 16px 16px;">

                            <h2 class="greeting"
                                style="margin:0; color:#35353a; font-size:21px; font-weight:bold; line-height:28px;">
                                Hello {{displayName}},
                            </h2>

                            <p style="margin:12px 0 0; color:#526176; font-size:15px; line-height:24px;">
                                Thank you for interviewing{{#if jobTitle}} for the
                                <span style="color:#35353a; font-weight:600;">{{jobTitle}}{{#if jobLocation}} ({{jobLocation}}){{/if}}</span> role{{/if}} at
                                {{companyName}}. We are pleased to confirm that you have
                                <span style="color:#35353a; font-weight:600;">passed the interview</span>.
                            </p>

                            <p style="margin:12px 0 0; color:#526176; font-size:15px; line-height:24px;">
                                Your next step is to create your account. Click the button below to register.
                            </p>

                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td class="btn-cell" align="center" style="padding:28px 0 26px;">
                                        <a href="{{registrationLink}}"
                                            style="display:inline-block; width:260px; padding:15px 0; background-color:#4289c8; border-radius:8px; color:#ffffff; font-size:15px; font-weight:bold; line-height:18px; text-align:center; text-decoration:none;">
                                            Complete registration
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin:0; color:#526176; font-size:15px; line-height:24px;">
                                Best regards,<br />
                                <span style="color:#35353a; font-weight:600;">The {{companyName}} Team</span>
                            </p>

                        </td>
                    </tr>

                    <tr>
                        <td align="center" style="padding:22px 20px 4px;">
                            <p style="margin:0 0 5px; color:#94a3b8; font-size:11px; line-height:17px;">
                                &copy; {{companyName}}. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>
